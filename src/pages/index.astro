---
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import BlogCard from '@/components/react/blog-card'
import Skills from '@/components/react/skills'
import { buttonVariants } from '@/components/ui/button'
import Logo from '@/components/ui/logo'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts, getAllProjects } from '@/lib/data-utils'
import { SITE } from '@/consts'
import { Icon } from 'astro-icon/components'

const blog = await getRecentPosts(3)
const projects = await getAllProjects()
const currentUrl = Astro.url;
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="Builder, Marketer, Baker" />
  <section class="flex flex-col gap-y-12 px-4 py-8 sm:px-8 lg:px-16">
    <div
      class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:gap-8 sm:text-left"
    >
      <div class="relative overflow-hidden rounded-lg sm:shrink-0 sm:overflow-hidden sm:rounded-lg">
        <Logo
          className="h-auto w-40 object-cover sm:w-48 md:w-56 lg:w-64 "
        />
      </div>
      <div class="mt-8 sm:mt-0 sm:max-w-xl">
        <h1
          class="font-custom text-foreground text-start text-4xl font-extrabold sm:text-5xl"
        >
          {SITE.title}
        </h1>
        <div class="mt-4 flex items-center gap-2" aria-label="location">
          <span
            class="bg-primary text-primary-foreground ring-primary/30 rounded-full px-3 py-1 text-sm font-medium ring-1"
          >
            I'm from
          </span>
          <span class="flex items-center gap-1">
            <span class="text-foreground text-sm font-medium"> {SITE.location}</span>
            <!-- Indian Flag -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 900 600"
              class="h-5 w-7 transition-transform duration-500 hover:rotate-12 rounded-sm"
              aria-hidden="true"
              role="img"
            >
              <rect fill="#f93" width="900" height="200"/>
              <rect fill="#fff" y="200" width="900" height="200"/>
              <rect fill="#128807" y="400" width="900" height="200"/>
              <circle cx="450" cy="300" r="60" fill="#000080"/>
              <circle cx="450" cy="300" r="50" fill="#fff"/>
            </svg>
          </span>
        </div>
        <p class="text-md text-foreground mt-4 text-start font-sans" title="description" aria-label="description">
          {SITE.description}
        </p>
      </div>
    </div>

    <!-- Three Facets Section -->
    <section class="relative" aria-labelledby="facets-title">
      <h2
        id="facets-title"
        class="font-custom text-foreground text-2xl font-bold"
      >
        Three Facets
      </h2>
      <p class="text-muted-foreground text-sm mb-6">
        What I do, organized into three categories.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Build Card -->
        <a href="/build" class="group relative overflow-hidden rounded-2xl border border-blue-500/20 bg-card p-6 transition-all duration-300 hover:border-blue-500/50 hover:shadow-lg hover:shadow-blue-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-blue-500/10">
              <Icon name="lucide:cpu" class="h-6 w-6 text-blue-500" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-foreground">Build</h3>
              <p class="text-xs text-blue-500 font-medium">AI + Software</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground mb-4">
            AI experiments, developer tools, and software projects.
          </p>
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-foreground">{projects.length} projects</span>
            <span class="text-blue-500 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Market Card -->
        <a href="/market" class="group relative overflow-hidden rounded-2xl border border-green-500/20 bg-card p-6 transition-all duration-300 hover:border-green-500/50 hover:shadow-lg hover:shadow-green-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-green-500/10">
              <Icon name="lucide:trending-up" class="h-6 w-6 text-green-500" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-foreground">Market</h3>
              <p class="text-xs text-green-500 font-medium">Product + Growth</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground mb-4">
            Product strategy, growth experiments, and professional experience.
          </p>
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Coming soon</span>
            <span class="text-green-500 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Bake Card -->
        <a href="/bake" class="group relative overflow-hidden rounded-2xl border border-orange-500/20 bg-card p-6 transition-all duration-300 hover:border-orange-500/50 hover:shadow-lg hover:shadow-orange-500/10">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-orange-500/10">
              <Icon name="lucide:cookie" class="h-6 w-6 text-orange-500" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-foreground">Bake</h3>
              <p class="text-xs text-orange-500 font-medium">Sourdough & More</p>
            </div>
          </div>
          <p class="text-sm text-muted-foreground mb-4">
            Sourdough adventures, baking experiments, and culinary creations.
          </p>
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Coming soon</span>
            <span class="text-orange-500 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      </div>
    </section>

    <section class="relative" aria-labelledby="skills-title">
      <h2
        id="skills-title"
        class="font-custom text-foreground text-2xl font-bold"
        title="skills"
        aria-label="skills"
        role="heading"
      >
        Skills & Technologies
      </h2>
      <p class="text-muted-foreground text-sm" aria-label="skills description">
        Here are some of the technologies I've been working with:
      </p>
      <div>
        <Skills client:load />
      </div>
    </section>

    <section class="flex flex-col gap-y-4" aria-labelledby="latest-posts-title" role="region">
      <div class="relative" aria-labelledby="latest-posts-title">
        <h2
          id="latest-posts-title"
          class="font-custom text-foreground text-2xl font-bold"
          title="latest blog posts"
          aria-label="latest blog posts"
        >
          Latest Blog Posts
        </h2>
        <p class="text-muted-foreground text-sm" aria-label="blog description">
          Here are some of my latest blog posts. You can find more on my blog
          page.
        </p>
      </div>
      <ul class="flex flex-col gap-y-4">
        {
          blog.map((post) => (
            <li>
              <BlogCard entry={post} />
            </li>
          ))
        }
      </ul>
      <div class="flex justify-center" aria-label="see all posts">
        <Link
          href="/blog"
          class={buttonVariants({ variant: 'ghost' }) + ' group'}
        >
          See all posts <span
            class="ml-1.5 transition-transform group-hover:translate-x-1"
            >&rarr;</span
          >
        </Link>
      </div>
    </section>
  </section>
</Layout>
