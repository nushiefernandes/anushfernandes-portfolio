---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

const currentUrl = Astro.url;
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="Market - Product & Growth" />
  <Breadcrumbs
    items={[
      { label: 'Market', href: '/market', icon: 'lucide:trending-up' },
    ]}
  />

  <section class="max-screen mt-12 px-4 md:px-6" data-section="market">
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
      <div class="flex w-fit items-center gap-2 text-green-500 mb-4">
        <Icon name="lucide:trending-up" class="h-8 w-8 animate-pulse" />
      </div>
      <h1 class="font-custom text-foreground text-4xl font-bold mb-4">
        Market
      </h1>
      <p class="text-muted-foreground text-lg max-w-md mb-2">
        Product strategy, growth experiments, and professional experience.
      </p>
      <div class="mt-8 p-6 rounded-2xl border border-green-500/20 bg-green-500/5">
        <p class="text-green-500 font-medium">Coming Soon</p>
        <p class="text-muted-foreground text-sm mt-2">
          Employment history and case studies are on the way.
        </p>
      </div>
    </div>
  </section>
</Layout>
